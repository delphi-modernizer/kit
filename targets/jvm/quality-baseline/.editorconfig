# Formatting for Java repositories, following the Google Java Style Guide.
# google-java-format (Spotless) is the authority; these settings keep editors from fighting it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100
ij_continuation_indent_size = 4
ij_java_imports_layout = $*,|,*
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

[*.{xml,yml,yaml,json,properties}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
