{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/docs/**)",
      "Edit(/target/**)",
      "Bash(dmz status *)",
      "Bash(dmz scan *)",
      "Bash(dmz trace *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Edit(/legacy/**)",
      "Edit(/.modernizer/**)",
      "Edit(/.claude/**)",
      "Edit(/modernizer.json)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Bash(dmz approve *)",
      "Bash(dmz revoke *)",
      "Bash(dmz init *)",
      "Bash(dmz stack *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git rebase *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dmz guard pre-tool-use || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
