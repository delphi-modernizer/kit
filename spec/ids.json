  "nfrCategories": {
    "PERF": "Performance and efficiency",
    "SCAL": "Scalability",
    "AVAIL": "Availability and reliability",
    "SEC": "Security",
    "MAINT": "Maintainability and extensibility",
    "USAB": "Usability and accessibility",
    "COMPAT": "Compatibility and portability",
    "OBS": "Observability and operability",
    "DATA": "Data integrity and consistency",
    "OTHER": "Regulatory, legal, privacy and other"
