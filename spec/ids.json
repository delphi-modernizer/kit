  "evidence": {
    "pattern": "(?:\\.\\./)*legacy/([^\\s)\\]#`'\\\"]+)#L(\\d+)(?:-L(\\d+))?",
    "root": "legacy/",
    "groups": {
      "path": 1,
      "start": 2,
      "end": 3
    }
  },
  "delimiters": {
    "before": "(?<![A-Za-z0-9_-])",
    "after": "(?![A-Za-z0-9_]|-[A-Za-z0-9])"
  }
