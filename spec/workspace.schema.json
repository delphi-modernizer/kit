{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/delphi-modernizer/kit/spec/workspace.schema.json",
  "title": "modernizer.json",
  "description": "The workspace manifest. The engine writes it at init; people change targetStack through the studio or dmz.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kitVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "targetStack": {
      "enum": [
        "dotnet",
        "jvm",
        "deferred"
      ]
    },
    "legacy": {
      "type": "object",
      "properties": {
        "path": {
          "const": "legacy"
        },
        "codePage": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "codePage"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdWith": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "kitVersion",
    "targetStack",
    "legacy",
    "createdAt",
    "createdWith"
  ],
  "additionalProperties": false
}
